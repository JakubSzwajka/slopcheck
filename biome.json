{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["@jakubszwajka/house-rules/biome"],
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!package-lock.json",
      "!!.scratch",
      "!!coverage",
      "!!dist"
    ]
  }
}
